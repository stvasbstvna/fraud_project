{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fraud-project/benchmark-v2-semantic-frame.schema.json",
  "title": "Benchmark v2 semantic frame",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{"required": ["source_id"]}],
  "required": ["scenario_id", "scenario_family_id", "population", "label", "source_type", "source_reference", "banking_event", "sender_role", "canonical_intent", "communicative_goal", "scenario_facts", "critical_invariants", "requested_action", "action_channel", "requested_information_type", "entity_placeholders", "merchant_placeholder", "financial_amount_placeholder", "currency_placeholder", "time_reference", "transaction_type", "transaction_status", "account_card_context", "url_present", "url_placeholder", "tactic", "urgency_level", "personalization_level", "message_length_target", "language", "country_context", "provenance", "license", "created_at_utc"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^BV2-S[0-9]{6}$"},
    "scenario_family_id": {"type": "string", "pattern": "^BV2-F[0-9]{6}$"},
    "population": {"enum": ["quality_validation", "confirmatory_final_test"]},
    "label": {"enum": ["phishing", "legitimate"]},
    "source_id": {"type": "string", "pattern": "^BV2-SRC-[0-9]{4}$"},
    "source_type": {"enum": ["public_real", "transformed_real", "fully_synthetic"]},
    "source_reference": {"type": "string", "minLength": 1},
    "banking_event": {"enum": ["unusual_transaction", "card_lock_or_restriction", "card_delivery", "payment_confirmation", "transfer_confirmation", "refund", "account_profile_update", "fraud_review", "one_time_security_code", "branch_or_appointment_notice", "statement_availability", "replacement_card", "direct_deposit_notice", "subscription_or_recurring_payment_alert", "other_documented"]},
    "sender_role": {"enum": ["bank", "card_issuer", "fraud_team", "payment_service", "branch", "merchant", "unknown_claimed_sender"]},
    "canonical_intent": {"type": "string", "minLength": 3},
    "communicative_goal": {"enum": ["inform", "request_review", "request_confirmation", "request_account_action", "provide_security_code", "schedule_or_route", "reassure", "other_documented"]},
    "scenario_facts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "boolean", "null"]}},
    "critical_invariants": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requested_action": {"enum": ["no_action", "review_information", "confirm_or_deny_transaction", "sign_in", "follow_link", "call_number", "reply_by_sms", "visit_branch", "wait_for_further_communication", "provide_information"]},
    "action_channel": {"enum": ["none", "message_only", "web", "phone", "sms_reply", "in_person", "banking_app", "unspecified"]},
    "requested_information_type": {"enum": ["none", "transaction_confirmation", "identity_information", "account_information", "security_information", "contact_information", "other_documented"]},
    "entity_placeholders": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"enum": ["[BANK]", "[MERCHANT]", "[AMOUNT]", "[CURRENCY]", "[DATE]", "[REFERENCE_ID]", "[DEFANGED_URL]", "[PHONE_PLACEHOLDER]"]}},
    "merchant_placeholder": {"type": ["string", "null"], "enum": ["[MERCHANT]", null]},
    "financial_amount_placeholder": {"type": ["string", "null"], "enum": ["[AMOUNT]", null]},
    "currency_placeholder": {"type": ["string", "null"], "enum": ["[CURRENCY]", null]},
    "time_reference": {"type": ["string", "null"], "enum": ["[DATE]", "none", null]},
    "transaction_type": {"enum": ["none", "purchase", "transfer", "refund", "deposit", "withdrawal", "subscription", "fee", "other_documented"]},
    "transaction_status": {"enum": ["none", "pending", "completed", "declined", "disputed", "scheduled", "cancelled", "unknown"]},
    "account_card_context": {"enum": ["none", "account", "debit_card", "credit_card", "replacement_card", "digital_wallet", "multiple_or_unspecified"]},
    "url_present": {"type": "boolean"},
    "url_placeholder": {"type": ["string", "null"], "enum": ["[DEFANGED_URL]", null]},
    "tactic": {"enum": ["authority", "urgency", "fear_or_loss_avoidance", "scarcity", "reward", "helpfulness", "routine_notification", "reassurance", "social_proof", "no_persuasion_tactic"]},
    "urgency_level": {"enum": ["none", "low", "moderate", "high"]},
    "personalization_level": {"enum": ["none", "generic_account_context", "placeholder_personalization"]},
    "message_length_target": {"type": "object", "additionalProperties": false, "required": ["min_characters", "max_characters"], "properties": {"min_characters": {"type": "integer", "minimum": 10, "maximum": 480}, "max_characters": {"type": "integer", "minimum": 10, "maximum": 480}}},
    "language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
    "country_context": {"type": "string", "minLength": 2},
    "provenance": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
