{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fraud-project/benchmark-v2-variant.schema.json",
  "title": "Benchmark v2 textual variant",
  "type": "object",
  "additionalProperties": false,
  "required": ["variant_id", "scenario_id", "population", "condition", "replicate_id", "creation_method", "parent_variant_id", "anchor_variant_id", "transformation_id", "transformation_factors", "generator_block_id", "text", "label", "generator_provider", "generator_model", "model_version", "prompt_id", "prompt_version", "temperature", "seed", "response_id", "generated_at_utc", "validation_status", "human_review_status", "exclusion_reason", "generation_metadata"],
  "properties": {
    "variant_id": {"type": "string", "pattern": "^BV2-V[0-9]{6}-C[0-3]-R[0-9]{2}$"},
    "scenario_id": {"type": "string", "pattern": "^BV2-S[0-9]{6}$"},
    "population": {"enum": ["quality_validation", "confirmatory_final_test"]},
    "condition": {"enum": ["C0_template", "C1_fluent", "C2_natural", "C3_natural_softened"]},
    "replicate_id": {"type": "integer", "minimum": 1},
    "creation_method": {"enum": ["public_source_anchor", "transformed_real_anchor", "human_authored_anchor", "deterministic_template_anchor", "llm_generated"]},
    "parent_variant_id": {"type": ["string", "null"], "pattern": "^BV2-V[0-9]{6}-C[0-3]-R[0-9]{2}$"},
    "anchor_variant_id": {"type": "string", "pattern": "^BV2-V[0-9]{6}-C0-R[0-9]{2}$"},
    "transformation_id": {"type": "string", "minLength": 1},
    "transformation_factors": {
      "type": "object", "additionalProperties": false,
      "required": ["fluency", "lexical_variation", "syntactic_variation", "conversational_naturalness", "action_explicitness", "urgency_changed", "personalization_changed"],
      "properties": {
        "fluency": {"enum": ["anchor", "corrected", "natural"]},
        "lexical_variation": {"enum": ["none", "minimal", "meaningful"]},
        "syntactic_variation": {"enum": ["none", "minimal", "meaningful"]},
        "conversational_naturalness": {"enum": ["template", "limited", "natural"]},
        "action_explicitness": {"enum": ["anchor", "unchanged", "softened"]},
        "urgency_changed": {"type": "boolean"},
        "personalization_changed": {"type": "boolean"}
      }
    },
    "generator_block_id": {"type": ["string", "null"], "minLength": 1},
    "text": {"type": "string", "minLength": 1, "maxLength": 480},
    "label": {"enum": ["phishing", "legitimate"]},
    "generator_provider": {"type": ["string", "null"], "minLength": 1},
    "generator_model": {"type": ["string", "null"], "minLength": 1},
    "model_version": {"type": ["string", "null"], "minLength": 1},
    "prompt_id": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "temperature": {"type": ["number", "null"], "minimum": 0, "maximum": 2},
    "seed": {"type": ["integer", "null"]},
    "response_id": {"type": ["string", "null"]},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "validation_status": {"enum": ["pending", "passed", "failed"]},
    "human_review_status": {"enum": ["pending", "approved", "rejected", "uncertain"]},
    "exclusion_reason": {"type": ["string", "null"], "enum": [null, "schema_failure", "semantic_intent_changed", "requested_action_changed", "label_changed", "entity_or_fact_changed", "operational_detail_added", "live_or_unsafe_destination", "condition_violation", "exact_or_near_duplicate", "corrupted_or_unreadable_text", "condition_specific_quality_failure", "licensing_or_provenance_failure", "other"]},
    "generation_metadata": {"type": "object"}
  },
  "allOf": [{
    "if": {"properties": {"creation_method": {"const": "llm_generated"}}},
    "then": {"properties": {
      "generator_block_id": {"type": "string", "minLength": 1},
      "generator_provider": {"type": "string", "minLength": 1},
      "generator_model": {"type": "string", "minLength": 1},
      "model_version": {"type": "string", "minLength": 1},
      "temperature": {"type": "number", "minimum": 0, "maximum": 2}
    }}
  }]
}
